# Expense Tracker - Git Ignore File
# Prevents sensitive financial data from being committed to repository

# ==================== DATABASE FILES ====================
# CRITICAL: Never commit database files (contain financial data)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ==================== APPLICATION DATA ====================
# User data directories
backups/
exports/
logs/

# User-specific data
/data/
*.csv
*.xlsx
*.xls

# ==================== PYTHON ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Virtual environments
.venv
env/
venv/
ENV/

# pyenv
.python-version

# PEP 582
__pypackages__/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

