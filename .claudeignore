# .claudeignore - Files excluded from Claude Code context
# This prevents sensitive files from being sent to Claude AI

# ==================== DATABASE FILES ====================
# CRITICAL: Contains user financial data
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Database dumps / exports
*.sql
*.dump
*.bson

# ==================== ENVIRONMENT / SECRETS ====================
# CRITICAL: Never send credentials to AI

# Environment files (all variations)
.env
.env.*
.envrc
*.env
*-env
env.*
environment.*
.environment
*.environment

# Secret / credential files
secrets.*
credentials.*
.secrets/
*.secret
*.secrets
*.token
*.tokens
.vault-token
vault.*
.vault/
*.apikey
*.api-key
api-keys.*
api_keys.*

# ==================== CONFIG FILES WITH SECRETS ====================
# Only block config files likely to contain secrets
# Project configs like pyproject.toml, setup.cfg, docker-compose.yml remain available
*secret*.ini
*secret*.conf
*secret*.cfg
*secret*.yaml
*secret*.yml
*secret*.toml
*credential*.ini
*credential*.conf
*credential*.yaml
*credential*.yml
*password*.ini
*password*.conf
*password*.yaml
*password*.yml
config.local.*
*.local.yaml
*.local.yml
*.local.toml
*.local.ini
*.local.conf
*.production.yaml
*.production.yml
*.production.toml

# ==================== PRIVATE KEYS / CERTIFICATES ====================

# PEM / OpenSSL
*.pem
*.key
*.cert
*.crt
*.cer
*.csr
*.der

# PKCS formats
*.p12
*.pfx
*.p7b
*.p8

# Java keystores
*.jks
*.jceks
*.keystore
*.truststore

# macOS keychain
*.keychain
*.keychain-db

# SSH keys
.ssh/
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
known_hosts
authorized_keys
*.ppk

# GPG keys
*.gpg
*.asc
.gnupg/

# OAuth / JWT
*.jwk
*.jwks

# ==================== PASSWORD / AUTH FILES ====================
*.htpasswd
*.htaccess
*.netrc
*.pgpass
*.my.cnf

# Password manager files
*.kdbx
*.kdb

# Crypto wallets
wallet.dat
*.wallet

# ==================== CLOUD CREDENTIALS ====================
.aws/
.gcloud/
.azure/
*.boto
.s3cfg

# ==================== TOOL AUTH ====================
# These may contain auth tokens or registry credentials
.npmrc
.pypirc
.git-credentials
.gitcredentials
.dockercfg
.docker/config.json

# ==================== HISTORY FILES ====================
# May contain typed passwords, queries, or sensitive commands
.*_history
.python_history
.node_repl_history
.psql_history
.mysql_history
.sqlite_history
.bash_history
.zsh_history

# ==================== VPN / REMOTE ACCESS ====================
*.ovpn
*.rdp
*.vnc

# ==================== ENCRYPTED FILES ====================
*.enc
*.encrypted

# ==================== TERRAFORM / IAC ====================
*.tfvars
*.tfstate
*.tfstate.backup

# ==================== USER DATA ====================
backups/
exports/
logs/
data/

# ==================== BUILD OUTPUTS ====================
# Large binary files not useful for AI context
build/
dist/
installer_output/
*.exe
*.msi

# ==================== CACHE / TEMP ====================
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.cache/
*.tmp
*.bak

# ==================== ARCHIVES ====================
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.tar.bz2
*.tar.xz

# ==================== MEMORY / DEBUG DUMPS ====================
# May contain sensitive data from memory
*.dmp
*.dump
*.mdmp
*.hdmp
core
core.*
*.stackdump
*.crash
*.crashlog

# ==================== MEDIA FILES (Screenshots/Videos) ====================
# May contain sensitive UI screenshots or recordings
screenshots/
recordings/
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm
*.m4v
# Note: Icon files in resources/ should be accessible for development

# ==================== SESSION / CACHE FILES ====================
# May contain auth tokens or session data
*.session
*.sessions
.session/
sessions/
*.cache
cache/
.cache/
*.cookie
*.cookies
cookies/
.cookies/
browserstorage/
localstorage/
sessionstorage/

# ==================== EDITOR SWAP / BACKUP FILES ====================
# May contain sensitive data from unsaved edits
*.swp
*.swo
*.swn
*~
.*.sw?
\#*\#
.#*
*.orig
*.rej
.DS_Store

# ==================== IDE WORKSPACE / CONFIG ====================
# May contain credentials or sensitive paths
.vscode/settings.json
.vscode/launch.json
.idea/workspace.xml
.idea/tasks.xml
*.iml
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ==================== API TESTING / COLLECTIONS ====================
# May contain real API keys or test data
*.postman_collection.json
*.postman_environment.json
insomnia.json
.insomnia/
thunder-tests/
.http
*.rest
api-requests/
requests/

# ==================== CONFIGURATION MANAGER SECRETS ====================
# Ansible
ansible_vault.*
vault.yml
vault.yaml
*vault*.yml
*vault*.yaml
group_vars/*/vault*
host_vars/*/vault*

# Chef/Puppet
encrypted_data_bag_secret
*.pem.encrypted

# Kubernetes
kubeconfig
*.kubeconfig
kube-config
*-kubeconfig.yaml

# ==================== BROWSER / APP DATA ====================
# May contain cached credentials
.mozilla/
.chrome/
.chromium/
.opera/
.brave/
browser-data/
app-data/

# ==================== EMAIL / COMMUNICATION ====================
*.mbox
*.eml
*.msg
mail/
emails/

# ==================== PASSWORD MANAGER EXPORTS ====================
*.1pif
*.1pux
*.agilekeychain
*.opvault
*.lpd
*.lastpass
*.dashlane
*.csv.encrypted
passwords.csv
passwords.txt
credentials.csv
credentials.txt

# ==================== DIFF / PATCH FILES ====================
# May inadvertently contain secrets in diffs
*.patch
*.diff
*.rej
patches/

# ==================== JUPYTER NOTEBOOKS WITH OUTPUTS ====================
# Outputs may contain sensitive data
*.ipynb_checkpoints/
.ipynb_checkpoints/
# Note: .ipynb files themselves are OK (we can see structure but not executed outputs)

# ==================== LOG FILES WITH SENSITIVE DATA ====================
# May contain stack traces with env vars, queries, or errors
*.log
*.log.*
*.log.gz
*.log.bz2
logs/
log/
*.out
*.err

# ==================== DATA EXPORTS / DUMPS ====================
# User data and exports
*.csv
*.xlsx
*.xls
*.xlsm
*.ods
*.tsv
*.json.bak
data/
exports/
backups/
*.backup

# ==================== WINDOWS SPECIFIC ====================
# Windows Credential Manager exports
credentials.xml
*.rdg
*.rdp
Desktop.ini
Thumbs.db
$RECYCLE.BIN/

# ==================== PROFILER / TRACING OUTPUTS ====================
# May contain sensitive runtime data
*.prof
*.profile
*.trace
*.perf
*.hprof
*.pprof
.profiler/
profiler/

# ==================== DOCKER / CONTAINER SECRETS ====================
# Docker secrets
.docker/config.json
docker-compose.override.yml
docker-compose.prod.yml
docker-compose.production.yml
secrets/

# ==================== VERSION CONTROL INTERNALS ====================
# May contain auth or sensitive commit data
.git/config
.git/credentials
.git-credentials
.git-ftp-*
.svn/
.hg/

# ==================== NODE / NPM ====================
# May contain auth tokens
.npmrc
.yarnrc
.yarn/
node_modules/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================== PYTHON SPECIFIC ====================
# May contain pickled objects with sensitive data
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# ==================== JAVA / JVM ====================
# May contain serialized sensitive objects
*.ser
*.jdo

# ==================== RUBY ====================
.bundle/config
.bundle/credentials

# ==================== PHP ====================
.env.php
.env.local.php

# ==================== MOBILE APP DATA ====================
# iOS
*.mobileprovision
*.p12
*.cer

# Android
*.keystore
keystore.properties
google-services.json
GoogleService-Info.plist

# ==================== GAME SAVES / USER DATA ====================
# May contain user information
saves/
savedata/
userdata/

# ==================== FINANCIAL / ACCOUNTING ====================
# Specific to this app - financial data
transactions/
accounts/
invoices/
receipts/
statements/
*.qif
*.ofx
*.qfx
*.qbo

# ==================== PERSONAL NOTES ====================
# May contain sensitive notes
personal_notes.*
my_notes.*
notes.txt
notes.md
todo_personal.*
journal.*
diary.*

# ==================== TEST DATA WITH REAL INFO ====================
# Test data that might use real information
test_data_real/
real_data/
production_data/
prod_data/
sample_data_real/
